<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Exposes the peer-update download path so FileProvider can mint
        content:// URIs the system PackageInstaller can read. Only the
        peer-updates subdirectory is exposed — nothing else under
        cacheDir/ is grant-able.
    -->
    <cache-path
        name="peer-updates"
        path="peer-updates/" />

    <!--
        Staging dir for outbound APK sharing via Intent.ACTION_SEND.
        ApkShareIntent copies the running APK here so FileProvider can
        mint a content:// URI that Gmail / Signal / Bluetooth / etc.
        can read. Nothing else under cacheDir/ is exposed.
    -->
    <cache-path
        name="share-out"
        path="share-out/" />
</paths>
