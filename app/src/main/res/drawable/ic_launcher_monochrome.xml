<!--
    Monochrome icon for Android 13+ themed-icon rendering. The
    launcher tints this with the user's wallpaper-derived palette,
    so all colours collapse to a single fill — keystone and arch
    become one silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M 32,84 L 32,54 C 32,32 32,32 54,32 C 76,32 76,32 76,54 L 76,84"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 45.5,30.5 L 62.5,30.5 L 59.5,46.5 L 48.5,46.5 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
