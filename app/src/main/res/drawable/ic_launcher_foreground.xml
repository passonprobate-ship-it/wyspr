<?xml version="1.0" encoding="utf-8"?>
<!--
    Wyspr adaptive-icon foreground. A stylised speech bubble with
    three sound waves emanating from inside it, on a closed-mouth
    profile — "what's said here, stays here." Reads as
    "whispered messaging," matches the brand name.

    Layout sits inside the inner 66dp safe zone of the 108dp adaptive
    canvas. Stroke endpoints are within radius 33 of (54,54) so the
    icon is fully visible under every mask shape (circle, squircle,
    rounded square, teardrop).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speech-bubble silhouette: rounded rectangle with a tail
         dropping to the lower-left. Slightly tilted (axis at 6°)
         so it doesn't read as a flat box. Stroked, not filled, so
         the wave glyphs inside stand out. -->
    <path
        android:pathData="M 32,30 L 76,30 Q 84,30 84,38 L 84,64 Q 84,72 76,72 L 50,72 L 36,84 L 40,72 L 32,72 Q 24,72 24,64 L 24,38 Q 24,30 32,30 Z"
        android:strokeColor="@color/ic_launcher_accent"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Three concentric arcs centred at the bubble origin (54,50),
         offset radii. Reads as ripples / sound waves whispered from
         the speaker. Shortest in the middle so they don't crowd
         the bubble outline. -->
    <path
        android:pathData="M 42,50 Q 54,38 66,50"
        android:strokeColor="@color/ic_launcher_wyspr"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M 46,56 Q 54,49 62,56"
        android:strokeColor="@color/ic_launcher_wyspr"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M 50,62 Q 54,58 58,62"
        android:strokeColor="@color/ic_launcher_wyspr"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
