<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera — handshake QR scan only. Removed if user revokes; the
         onboarding screen handles the denial path explicitly. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Microphone — voice note recording. Runtime permission requested
         on first use; denial path handled in VoiceRecordController. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service for the transport stack — keeps BLE / WiFi
         Direct adapters alive while the app is in the background so peers
         can sync opportunistically. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BLE — API 31+ runtime permissions. neverForLocation tells the OS
         we're not deriving location from scans (we filter by service UUID),
         so the user isn't asked for location alongside Bluetooth. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />

    <!-- BLE — legacy API 26..30 permissions. BLUETOOTH/BLUETOOTH_ADMIN are
         normal (auto-granted). ACCESS_FINE_LOCATION is dangerous and is
         required for BLE scan results to be delivered (and for WiFi Direct
         discovery through API 32). maxSdkVersion=32 matches the wifidirect
         module so the manifest merger doesn't conflict; BLE alone wouldn't
         need anything past API 30. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!--
        Override the bluetooth_le and wifi.direct requirements declared
        by the core:transport:bluetooth and core:transport:wifidirect
        library manifests (which both set required="true"). Without the
        tools:replace, manifest merger picks the more restrictive value
        and the merged manifest gates installation behind both hardware
        features. We want Wyspr to be installable on any Android 8+
        device — BLE is the primary transport but isn't a hard
        prerequisite (a future build could add a Tor-only fallback).
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false"
        tools:replace="android:required" />

    <!-- Wake locks — never long-lived; bounded to active sync sessions. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional: lets the user grant a battery-optimization exemption so
         the foreground service hosting a mailbox doesn't get killed by
         Doze. Always user-initiated via the Settings system intent — we
         never silently elevate. Required only when running as a mailbox
         host; users who don't host can ignore the prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the app hand a downloaded peer-update APK to the system
         PackageInstaller. The user still has to tap "Install" in the
         system dialog; Android refuses any APK whose signer differs
         from the currently-installed app's signer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".WysprApplication"
        android:label="Wyspr"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:hasFragileUserData="true"
        android:theme="@style/Theme.Wyspr"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Wyspr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FLAG_SECURE applied per-window in MainActivity — prevents
             screenshots and surfacing in recents. -->

        <!-- FileProvider lets us mint content:// URIs for the
             downloaded peer-update APK so the system PackageInstaller
             can read it. Authority is "{applicationId}.fileprovider"
             and matches the lookup in PeerUpdateViewModel. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Keeps the BLE GATT server / WiFi P2P / HTTPS share server
             alive while the user is in a flow that needs the radio.
             Type "connectedDevice" matches the manifest permission
             declared above and is mandatory on Android 14+; combined
             with the existing BLUETOOTH_CONNECT runtime grant, the
             system permits this service type. -->
        <service
            android:name=".transport.TransportForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
